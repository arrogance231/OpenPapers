{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://openpapers.dev/schemas/scoped-fact.v1.json",
  "type":"object","required":["version","completenessPolicy","papers"],
  "properties":{
    "version":{"const":"research-facts-v5-development"},
    "completenessPolicy":{"const":"EXHAUSTIVE_WITHIN_SCOPE"},
    "papers":{"type":"array","minItems":1,"items":{"type":"object","required":["paperId","title","artifact","scope","allowedPredicateFamilies","sourceSections","goldFacts"],"properties":{
      "paperId":{"type":"string"},"title":{"type":"string"},
      "artifact":{"type":"object","required":["url","sha256","version"],"properties":{"url":{"type":"string","format":"uri"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"version":{"type":"string"}}},
      "scope":{"type":"object","required":["sections","policy"],"properties":{"sections":{"type":"array","items":{"type":"string"}},"subjects":{"type":"array","items":{"type":"string"}},"policy":{"const":"EXHAUSTIVE_WITHIN_SCOPE"}}},
      "allowedPredicateFamilies":{"type":"array","items":{"type":"string"}},
      "sourceSections":{"type":"array","items":{"type":"object","required":["heading","page","text"],"properties":{"heading":{"type":"string"},"page":{"type":"integer","minimum":1},"text":{"type":"string","minLength":1}}}},
      "goldFacts":{"type":"array","items":{"type":"object","required":["factId","predicate","canonicalValue","rawEvidence","page","section","locator","sourceClass","subject","scope","stage","annotationNote"],"properties":{"factId":{"type":"string"},"predicate":{"type":"string"},"canonicalValue":{},"rawEvidence":{"type":"string"},"page":{"type":"integer","minimum":1},"section":{"type":"string"},"locator":{"type":"string"},"sourceClass":{"type":"string"},"subject":{"type":"string"},"scope":{"type":"string"},"stage":{"type":"string"},"temporalContext":{"type":"string"},"annotationNote":{"type":"string"},"normalizationNote":{"type":"string"}}}}
    }}}
  }
}
